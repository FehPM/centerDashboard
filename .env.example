DATABASE_URL="postgresql://center:center@localhost:5432/center?schema=public"
REDIS_URL="redis://localhost:6379"
# Usadas apenas por docker-compose.prod.yml, para subir o container do Postgres
# e montar a DATABASE_URL interna (postgres:5432, não localhost). Em staging/produção
# reais, gere valores fortes — não deixe "center" literal.
POSTGRES_USER="center"
POSTGRES_PASSWORD="center"
POSTGRES_DB="center"
JWT_SECRET="troque-isto-por-32-caracteres-no-minimo"
# Segredo do back-office (/internal/*): 32+ caracteres e DIFERENTE de JWT_SECRET.
OPERATOR_JWT_SECRET="troque-isto-por-outro-segredo-de-32-caracteres"
# Proxies reversos confiáveis na frente da API (0 = nenhum; use 1 atrás de um proxy reverso).
# Define de onde vem o IP do cliente (rate limit e auditoria); errado, o IP pode ser forjado.
TRUST_PROXY_HOPS=0
# Origens permitidas no CORS (painel do cliente e back-office da Blan).
PANEL_ORIGIN="http://localhost:5173"
BACKOFFICE_ORIGIN="http://localhost:5174"
# Token global da Blan para o Monday (por cliente só o boardId).
MONDAY_API_TOKEN=""
PII_PEPPER="troque-isto-tambem-32-caracteres-min"
# 32 bytes em hex (64 caracteres). Gere com: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=""
ANTHROPIC_API_KEY=""
UAPPI_BASE_URL="https://api.uappi.com.br"
GA4_CREDENTIALS_JSON=""
# Property GA4/Firebase do app mobile. Vazia cai para GA4_CREDENTIALS_JSON (mcp-firebase).
GA4_APP_CREDENTIALS_JSON=""
# "true" liga clientes mock para Uappi/GA4/BigQuery — sem credenciais reais.
# Veja T5B, T17B e T36B. NUNCA "true" em produção.
MOCK_EXTERNAL_APIS="false"
# WhatsApp é OPCIONAL: se qualquer WHATSAPP_* ficar vazia, a integração fica desligada.
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="troque-isto"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# --- Apenas docker-compose.prod.yml ---
# Arquivo de env lido pelos containers (padrão: .env).
# ENV_FILE=.env
# URL pública da API embutida no bundle do back-office em tempo de BUILD da imagem.
# Mudou? Rebuild: docker compose -f docker-compose.prod.yml up -d --build backoffice
# BACKOFFICE_API_URL="http://localhost:3333"
# Interface em que API (3333) e back-office (8080) são publicados no host. Padrão 127.0.0.1:
# o proxy reverso do mesmo host alcança por loopback. Use 0.0.0.0 só se o proxy estiver em outra máquina.
# API_BIND=127.0.0.1
# BACKOFFICE_BIND=127.0.0.1
